# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EstateFlow AI

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/estateflow

# Authentication (generate with: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Cloudinary (Phase 6)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# AI (Phase 13)
AI_ENABLED=true
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Azure OpenAI (optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
# Rate limits
AI_MAX_REQUESTS_PER_MINUTE=20
AI_PUBLIC_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_TOKENS_PER_REQUEST=4000
AI_CACHE_REVALIDATE_SECONDS=3600
